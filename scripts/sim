#!/usr/bin/env python3
"""Assigned, isolated DSH simulation with resource ownership and retained evidence."""
import re,shutil,tempfile,argparse,contextlib,fcntl,hashlib,json,os,pathlib,signal,socket,subprocess,sys,time,urllib.request,uuid
ROOT=pathlib.Path(__file__).resolve().parents[1]
APP=pathlib.Path('/Applications/DeepSeek Harness.app/Contents')
def terminate(process):
    if process is None:return True
    with contextlib.suppress(ProcessLookupError):os.killpg(process.pid,signal.SIGTERM)
    try:process.wait(timeout=8)
    except subprocess.TimeoutExpired:pass
    with contextlib.suppress(ProcessLookupError):os.killpg(process.pid,signal.SIGKILL)
    process.wait()
    deadline=time.monotonic()+3
    while time.monotonic()<deadline:
        try:os.killpg(process.pid,0)
        except ProcessLookupError:return True
        except PermissionError:pass  # macOS can transiently deny a group probe while final descendants exit; never treat denial as cleanup.
        time.sleep(.05)
    return False
def command(argv,log,env,timeout=300,lock_fd=None):
    with log.open('w') as output:
        p=subprocess.Popen(argv,cwd=ROOT,env=env,stdout=output,stderr=subprocess.STDOUT,start_new_session=True,pass_fds=() if lock_fd is None else (lock_fd,))
        try:
            rc=p.wait(timeout=timeout)
            if rc:raise RuntimeError(f'Command failed ({rc}): {log}')
        finally:
            if not terminate(p):raise RuntimeError(f'Owned process group remains: {p.pid}; {log}')

def lab(args,run,state,env,lock):
    process=None;summary={'lane':'lab','status':'running','cleanup':False,'stateRoot':str(state)}
    try:
        command(['npm','run','build'],run/'build.log',env,300,lock.fileno())
        command(['npx','tsdown','--config','sim/lab/tsdown.config.ts'],run/'bundle.log',env,60,lock.fileno())
        out=(run/'host.log').open('w');process=subprocess.Popen(['node','sim/lab/server.mjs'],cwd=ROOT,env={**env,'PERSE_LAB_STATE':str(state)},stdout=out,stderr=subprocess.STDOUT,start_new_session=True,pass_fds=(lock.fileno(),))
        deadline=time.monotonic()+15
        while not (state/'runtime.json').exists():
            if process.poll() is not None or time.monotonic()>deadline:raise RuntimeError('Lab startup failed')
            time.sleep(.05)
        runtime=json.loads((state/'runtime.json').read_text());(run/'runtime.json').write_text(json.dumps(runtime));summary.update(runtime)
        print('LAB '+str(run)+' '+runtime['url'],flush=True)
        for repeat in range(args.repeat):
            evidence=run if args.repeat==1 else run/f'repeat-{repeat+1}';evidence.mkdir(exist_ok=True);(evidence/'runtime.json').write_text(json.dumps(runtime))
            command(['node','sim/lab/browser.mjs'],evidence/'browser.log',{**env,'PERSEVERE_DSH_SIM':str(evidence),'PERSE_LAB_SCENARIO':args.scenario},args.timeout,lock.fileno())
        summary['status']='passed'
        if args.keep:
            print('Preview active; Ctrl-C cleans only this Lab.',flush=True)
            while process.poll() is None:time.sleep(.5)
    except KeyboardInterrupt:
        if summary['status']!='passed':summary['status']='interrupted'
    except BaseException as error:summary.update(status='failed',error=str(error));print(str(error),file=sys.stderr)
    finally:
        summary['cleanup']=terminate(process)
        if process:out.close()
        (run/'summary.json').write_text(json.dumps(summary,indent=2));print(run/'summary.json',flush=True)
    return 0 if summary['status']=='passed' and summary['cleanup'] else 1

def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--lane',choices=['native','live','lab'],default='native');parser.add_argument('--scenario',default='all');parser.add_argument('--repeat',type=int,default=1);parser.add_argument('--keep',action='store_true');parser.add_argument('--timeout',type=int,default=180);args=parser.parse_args()
    if not 1<=args.repeat<=10:parser.error('--repeat must be between 1 and 10')
    if args.lane!='lab' and (args.repeat!=1 or args.scenario!='all'):parser.error('--scenario and --repeat apply to the Lab lane')
    def interrupted(_signal,_frame):raise KeyboardInterrupt()
    signal.signal(signal.SIGTERM,interrupted)
    build=ROOT/'.build';build.mkdir(exist_ok=True);lock=(build/'sim.lock').open('a+')
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:print('Another sim owns this checkout',file=sys.stderr);return 2
    run=build/'sim'/f'{time.strftime("%Y%m%d-%H%M%S")}-{uuid.uuid4().hex[:6]}';run.mkdir(parents=True,mode=0o700)
    state=pathlib.Path(tempfile.mkdtemp(prefix=f'perse-dashboard-{run.name}-'))
    home=state/'home';home.mkdir();workspace=state/'workspace';workspace.mkdir()
    (run/'state').symlink_to(state,target_is_directory=True)
    env={**os.environ,'DSH_HOME':str(home),'ELECTRON_RUN_AS_NODE':'1','DSH_TELEMETRY_ENABLED':'false','PERSEVERE_DSH_SIM_RUN':str(run),'PERSEVERE_DSH_EXPECT_CLIENT':str(home/'profiles/web/node_modules/perse-dashboard/lib/client.js')}
    # Exact caller-supplied CLI is supported on other hosts. Never resolve a shell string.
    if args.lane=='lab':return lab(args,run,state,env,lock)
    fixtures=state/'fixtures';fixtures.mkdir();(fixtures/'package.json').write_text(json.dumps({'name':'perse-dashboard-sim-fixtures','type':'module','private':True}));(fixtures/'node_modules').symlink_to(ROOT/'node_modules',target_is_directory=True)
    for filename in ['model.mjs','diagnostics.mjs']:shutil.copyfile(ROOT/'sim'/filename,fixtures/filename)
    cli=json.loads(os.environ.get('PERSEVERE_DSH_COMMAND',json.dumps([str(APP/'MacOS/DeepSeek Harness'),'--expose-internals',str(APP/'Resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js')])))
    version=subprocess.run(cli+['--version'],env=env,capture_output=True,text=True,check=True).stdout.strip()
    source=subprocess.run(['git','rev-parse','HEAD'],cwd=ROOT,capture_output=True,text=True)
    dirty=subprocess.run(['git','status','--porcelain'],cwd=ROOT,capture_output=True,text=True)
    summary={'sourceCommit':source.stdout.strip() if source.returncode==0 else 'uncommitted','sourceDirty':bool(dirty.stdout.strip()),'stateRoot':str(state),'runtimeVersion':version,'lane':args.lane,'runId':run.name,'home':str(home),'workspace':str(workspace),'status':'running','startedAt':time.time(),'assertions':[],'cleanup':False}
    process=None;out=None
    try:
        command(['npm','run','check'],run/'check.log',env,300,lock.fileno())
        packed=subprocess.run(['npm','pack','--json','--pack-destination',str(run)],cwd=ROOT,env=env,capture_output=True,text=True,check=True)
        archive=run/json.loads(packed.stdout)[0]['filename'];summary['packageSha256']=hashlib.sha256(archive.read_bytes()).hexdigest()
        # Official package installation into a new profile, never linked directories.
        command(cli+['plugin','--profile','web','add',str(archive)],run/'install.log',env,300,lock.fileno())
        if args.lane=='live':
            credentials=pathlib.Path(os.environ.get('PERSEVERE_DSH_CREDENTIALS',str(pathlib.Path.home()/'.dsh/.credentials.yaml')))
            if not credentials.is_file():raise RuntimeError('Live credentials unavailable; no model call was made')
            shutil.copyfile(credentials,home/'.credentials.yaml');os.chmod(home/'.credentials.yaml',0o600)
        with socket.socket() as s:s.bind(('127.0.0.1',0));port=s.getsockname()[1]
        patch=state/'sim.patch.yml';text='- id: session-log-deepseek\n  disabled: true\n- id: session-telemetry-otel\n  disabled: true\n- id: desktop-product-telemetry\n  disabled: true\n'
        if args.lane=='native':text+=f"- id: agent-default-model\n  config:\n    provider: dashboard-sim\n    model: sim\n- insert:\n    - id: dashboard-sim\n      name: {json.dumps(str(fixtures/'model.mjs'))}\n"
        text+=f'- insert:\n    - id: sim-diagnostics\n      name: {json.dumps(str(fixtures/"diagnostics.mjs"))}\n'
        text+=f'- id: workspace-controller\n  config:\n    documentsDirectory: {json.dumps(str(workspace))}\n'
        patch.write_text(text);(run/'sim.patch.yml').write_text(text)
        out=(run/'host.log').open('w');process=subprocess.Popen(cli+['web','--patch',str(patch),'--host','127.0.0.1','--port',str(port),'--no-open'],cwd=workspace,env=env,stdout=out,stderr=subprocess.STDOUT,start_new_session=True,pass_fds=(lock.fileno(),))
        summary.update(pid=process.pid,url=f'http://127.0.0.1:{port}')
        (run/'runtime.json').write_text(json.dumps(summary,indent=2));print(f'SIM {run.name} {summary["url"]}',flush=True)
        deadline=time.monotonic()+90
        while time.monotonic()<deadline:
            if process.poll() is not None:raise RuntimeError(f'DSH exited before readiness; {run/"host.log"}')
            try:
                with urllib.request.urlopen(summary['url'],timeout=1) as response:
                    if response.status==200:break
            except urllib.error.HTTPError as error:
                if error.code in (401,403):break
                time.sleep(.25)
            except Exception:time.sleep(.25)
        else:raise TimeoutError('DSH startup timed out')
        binding_deadline=time.monotonic()+5
        while not (run/'artifact-binding.json').exists():
            if time.monotonic()>binding_deadline:raise RuntimeError(f'Installed artifact binding failed; inspect {run/"host.log"}')
            time.sleep(.1)
        log=(run/'host.log').read_text()
        token=re.search(r'http://127\.0\.0\.1:'+str(port)+r'/\?token=([^\s]+)',log)
        if not token:raise RuntimeError('Missing isolated DSH authentication receipt')
        summary['authUrl']=summary['url']+'/?token='+token.group(1)
        (run/'runtime.json').write_text(json.dumps(summary,indent=2));os.chmod(run/'runtime.json',0o600)
        browser_env={**env,'PERSEVERE_DSH_SIM':str(run)}
        command(['node','sim/browser.mjs'],run/'browser.log',browser_env,args.timeout,lock.fileno())
        summary['assertions']=json.loads((run/'browser-results.json').read_text());summary['artifactBinding']=json.loads((run/'artifact-binding.json').read_text());summary['status']='passed'
        if args.keep:
            print('Preview active. Ctrl-C cleans up this sim only.',flush=True)
            while process.poll() is None:time.sleep(.5)
    except KeyboardInterrupt:
        if summary['status']!='passed':summary['status']='interrupted'
    except BaseException as error:
        summary.update(status='failed',error=str(error))
        if (run/'browser-results.json').exists():summary['assertions']=json.loads((run/'browser-results.json').read_text())
        print(str(error),file=sys.stderr)
    finally:
        cleaned=terminate(process)
        if not cleaned:summary.update(status='failed',error='Owned DSH process group remains; cleanup incomplete')
        if out:out.close()
        # Credentials are transient even when failed-run evidence is retained.
        (home/'.credentials.yaml').unlink(missing_ok=True)
        summary.pop('authUrl',None)
        summary.update(cleanup=cleaned,finishedAt=time.time());(run/'summary.json').write_text(json.dumps(summary,indent=2));print(str(run/'summary.json'),flush=True)
    return 0 if summary['status']=='passed' else 1
if __name__=='__main__':sys.exit(main())
